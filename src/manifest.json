{
  "manifest_version": 3,
  "name": "Firefonts",
  "version": "0.1.2",
  "description": "Changes the font of the sites you choose.",
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "browser_specific_settings": {
    "gecko": {
      "id": "firefonts@toshiotomikawa.github.io",
      "strict_min_version": "142.0",
      "update_url": "https://raw.githubusercontent.com/toshiotomikawa/firefonts/main/updates.json",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "scripts": ["lib.js", "background.js"] },
  "action": {
    "default_title": "Firefonts",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["*://*/*"]
    }
  ]
}
